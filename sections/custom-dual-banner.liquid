{{ 'custom-dual-banner.css' | asset_url | stylesheet_tag }}

<div class="cdb-section">
  <div class="container">
    <div class="cdb-grid">
      
      <!-- Banner 1 -->
      <div class="cdb-item">
        {%- if section.settings.link_1 != blank -%}
          <a href="{{ section.settings.link_1 }}" class="cdb-link">
        {%- else -%}
          <div class="cdb-link">
        {%- endif -%}
        
        {%- if section.settings.image_1 != blank -%}
          <img src="{{ section.settings.image_1 | img_url: '1000x' }}" alt="{{ section.settings.image_1.alt | escape }}" loading="lazy" class="cdb-img">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg cdb-img' }}
        {%- endif -%}
        
        {%- if section.settings.link_1 != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Banner 2 -->
      <div class="cdb-item">
        {%- if section.settings.link_2 != blank -%}
          <a href="{{ section.settings.link_2 }}" class="cdb-link">
        {%- else -%}
          <div class="cdb-link">
        {%- endif -%}
        
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | img_url: '1000x' }}" alt="{{ section.settings.image_2.alt | escape }}" loading="lazy" class="cdb-img">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg cdb-img' }}
        {%- endif -%}
        
        {%- if section.settings.link_2 != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dual Image Banners",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link 2"
    }
  ],
  "presets": [
    {
      "name": "Dual Image Banners",
      "category": "Image"
    }
  ]
}
{% endschema %}
