{{ 'custom-contact.css' | asset_url | stylesheet_tag }}

{% style %}
  .custom-contact-page {
    --brand-color: {{ section.settings.brand_color | default: '#245336' }};
  }
{% endstyle %}

<div class="custom-contact-page page-width">
  
  {% if section.blocks.size > 0 %}
  <div class="custom-contact-info-cards">
    {% for block in section.blocks %}
      {% if block.type == 'info_card' %}
        <div class="contact-info-card">
          <div class="contact-info-card__icon">
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% elsif block.settings.icon != blank %}
              <img src="{{ block.settings.icon | img_url: '100x' }}" alt="{{ block.settings.title }}">
            {% endif %}
          </div>
          <div class="contact-info-card__content">
            <h3 class="contact-info-card__title">{{ block.settings.title }}</h3>
            {% if block.settings.subtext != blank %}
              <p class="contact-info-card__subtext">{{ block.settings.subtext }}</p>
            {% endif %}
            <div class="contact-info-card__text">{{ block.settings.text }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <div class="custom-contact-main">
    
    <div class="contact-form-container">
      <div class="contact-form__header">
        {% if section.settings.form_icon_svg != blank %}
          <div class="contact-form__icon">{{ section.settings.form_icon_svg }}</div>
        {% endif %}
        <div>
          <h2 class="contact-form__title">{{ section.settings.form_title }}</h2>
          <p class="contact-form__subtitle">{{ section.settings.form_subtitle }}</p>
        </div>
      </div>

      {%- form 'contact', id: 'ContactForm', class: 'custom-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{ 'templates.contact.form.post_success' | t }}
          </p>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}

        <div class="contact-form__grid">
          <div class="custom-field">
            <label class="custom-field__label" for="ContactForm-name">Full Name *</label>
            <input
              class="custom-field__input"
              autocomplete="name"
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Enter your name"
              required
            >
          </div>
          <div class="custom-field">
            <label class="custom-field__label" for="ContactForm-email">Email Address *</label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="custom-field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="your@gmail.com"
              required
            >
          </div>
          <div class="custom-field">
            <label class="custom-field__label" for="ContactForm-phone">Phone Number *</label>
            <input
              type="tel"
              id="ContactForm-phone"
              class="custom-field__input"
              autocomplete="tel"
              name="contact[phone]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="9876543210"
              required
            >
          </div>
          <div class="custom-field">
            <label class="custom-field__label" for="ContactForm-subject">Subject *</label>
            <input
              class="custom-field__input"
              type="text"
              id="ContactForm-subject"
              name="contact[subject]"
              placeholder="What's this about?"
              required
            >
          </div>
        </div>
        
        <div class="custom-field custom-field--full">
          <label class="custom-field__label" for="ContactForm-body">Your Message *</label>
          <textarea
            rows="5"
            id="ContactForm-body"
            class="text-area custom-field__input"
            name="contact[body]"
            placeholder="Tell us about your travel plans..."
            required
          >
            {{- form.body -}}
          </textarea>
        </div>
        
        <div class="contact-form__submit">
          <button type="submit" class="button custom-btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Send Message
          </button>
        </div>
      {%- endform -%}
    </div>

    <div class="contact-map-whatsapp">
      {% if section.settings.map_iframe != blank %}
        <div class="contact-map">
          {{ section.settings.map_iframe }}
        </div>
      {% endif %}

      <div class="contact-whatsapp">
        <div class="contact-whatsapp__header">
          <svg class="contact-whatsapp__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 11.5C21 16.75 16.75 21 11.5 21C9.69255 21 8.00693 20.4907 6.5771 19.6053L2.5 21L4.04169 17.1519C3.00366 15.6171 2.5 13.6841 2.5 11.5C2.5 6.25 6.75 2 12 2C17.25 2 21 6.25 21 11.5Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3 class="contact-whatsapp__title">{{ section.settings.whatsapp_title }}</h3>
        </div>
        <div class="contact-whatsapp__text">
          {{ section.settings.whatsapp_text }}
        </div>
        <div class="contact-whatsapp__phone">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 16.92V19.92C22.0032 20.1986 21.9441 20.4743 21.8261 20.7294C21.7082 20.9846 21.5338 21.2137 21.3138 21.4022C21.0938 21.5907 20.8329 21.7346 20.5465 21.8254C20.2601 21.9162 19.9542 21.9521 19.65 21.93C16.5586 21.5936 13.619 20.5484 11.08 18.88C8.71536 17.3516 6.72124 15.3575 5.19284 12.9928C3.51532 10.4357 2.46973 7.47644 2.14002 4.36002C2.11795 4.05739 2.15372 3.75283 2.24392 3.46781C2.33413 3.18279 2.47708 2.92305 2.66442 2.70404C2.85176 2.48503 3.07955 2.31139 3.33367 2.19361C3.5878 2.07584 3.86289 2.01633 4.14002 2.02002H7.14002C7.62561 2.01493 8.0959 2.18525 8.47228 2.50285C8.84865 2.82046 9.10828 3.26601 9.21002 3.76002C9.33662 4.72031 9.57053 5.66017 9.91002 6.57002C10.0446 6.92984 10.082 7.32047 9.99849 7.70119C9.91497 8.08191 9.7136 8.43899 9.41002 8.74002L8.14002 10.01C9.56381 12.5135 11.6265 14.5762 14.13 16L15.4 14.73C15.701 14.4264 16.0581 14.2251 16.4388 14.1415C16.8195 14.058 17.2102 14.0954 17.57 14.23C18.4798 14.5695 19.4197 14.8034 20.38 14.93C20.8803 15.0333 21.3312 15.2974 21.6508 15.6803C21.9703 16.0632 22.1384 16.5401 22.13 17.03L22 16.92Z" stroke="#E18F3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <a href="tel:{{ section.settings.whatsapp_number }}">{{ section.settings.whatsapp_number }}</a>
        </div>
        <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '-' }}" target="_blank" class="button custom-btn-whatsapp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.0163 24C5.3855 24 0 18.6146 0 11.984C0 9.77448 0.589886 7.64951 1.7067 5.76019L0.355153 1.3411C0.292398 1.13601 0.347072 0.913702 0.501594 0.759245C0.656116 0.604787 0.878486 0.550186 1.08358 0.61286L5.61794 1.99613C7.5407 0.903875 9.72251 0.327026 12.0163 0.327026C18.647 0.327026 24.0326 5.71246 24.0326 12.3432C24.0326 18.9739 18.647 24.3594 12.0163 24Z" fill="white"/>
            <path d="M19.1417 15.3516L16.2736 14.1506C16.1425 14.0954 15.993 14.0967 15.8629 14.1542C15.7328 14.2117 15.6339 14.3204 15.5897 14.4545L14.7797 16.9048C12.3418 15.8776 10.4243 13.9169 9.42152 11.439L11.839 10.6074C11.9723 10.5615 12.0792 10.4601 12.134 10.3278C12.1888 10.1956 12.1866 10.0445 12.1284 9.91376L10.8876 7.04273C10.8258 6.9009 10.697 6.80402 10.5435 6.78443C10.3899 6.76484 10.2366 6.82548 10.1332 6.94589L8.43153 8.92484C8.28311 9.09783 8.21208 9.32426 8.23469 9.54925C8.42398 11.4552 9.28383 13.2201 10.6698 14.6133C12.0558 16.0064 13.8248 16.8773 15.7351 17.0786C15.9622 17.1026 16.1912 17.0326 16.366 16.8856L18.318 15.1764C18.4385 15.071 18.4975 14.9157 18.4752 14.7601C18.4529 14.6044 18.3533 14.4735 18.2097 14.4124L19.1417 15.3516Z" fill="#20B038"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Contact Page",
  "settings": [
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand Color",
      "default": "#245336"
    },
    {
      "type": "header",
      "content": "Contact Form Settings"
    },
    {
      "type": "html",
      "id": "form_icon_svg",
      "label": "Form Icon SVG",
      "default": "<svg width='40' height='40' viewBox='0 0 24 24' fill='currentColor'><path d='M21 11.5C21 16.75 16.75 21 11.5 21C9.69255 21 8.00693 20.4907 6.5771 19.6053L2.5 21L4.04169 17.1519C3.00366 15.6171 2.5 13.6841 2.5 11.5C2.5 6.25 6.75 2 12 2C17.25 2 21 6.25 21 11.5Z'/></svg>"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title",
      "default": "Send Us a Message"
    },
    {
      "type": "text",
      "id": "form_subtitle",
      "label": "Form Subtitle",
      "default": "We'll respond as quickly as possible"
    },
    {
      "type": "header",
      "content": "Map Settings"
    },
    {
      "type": "html",
      "id": "map_iframe",
      "label": "Google Maps Iframe HTML"
    },
    {
      "type": "header",
      "content": "WhatsApp Settings"
    },
    {
      "type": "text",
      "id": "whatsapp_title",
      "label": "WhatsApp Title",
      "default": "Need Immediate Help?"
    },
    {
      "type": "richtext",
      "id": "whatsapp_text",
      "label": "WhatsApp Text",
      "default": "<p>Our travel experts are available to assist you with booking, itinerary customization, and any questions.</p>"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number",
      "default": "8101344391"
    }
  ],
  "blocks": [
    {
      "type": "info_card",
      "name": "Info Card",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon (SVG code)"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (Image fallback)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Page"
    }
  ]
}
{% endschema %}
